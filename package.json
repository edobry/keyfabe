{
  "name": "keyfabe",
  "version": "0.5.3",
  "description": "CLI tool for Proxmark3 RFID tag cloning",
  "license": "MIT",
  "type": "module",
  "bin": {
    "keyfabe": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edobry/keyfabe.git"
  },
  "homepage": "https://github.com/edobry/keyfabe",
  "keywords": [
    "proxmark3",
    "rfid",
    "nfc",
    "mifare",
    "keyfob",
    "clone"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.2.2",
    "semantic-release": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
